<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Shared control styles and the default light palette. -->
    <FontFamily x:Key="WorkspaceFont">Noto Sans KR, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="SymbolFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="WorkspaceFontSize">14.666666666666666</sys:Double>
    <sys:Double x:Key="EditorFontSize">14.666666666666666</sys:Double>
    <sys:Double x:Key="WorkspaceSmallSize">13.166666666666666</sys:Double>
    <sys:Double x:Key="WorkspaceHeadingSize">16.666666666666666</sys:Double>
    <sys:Double x:Key="WorkspaceTitleSize">21.666666666666666</sys:Double>
    <LinearGradientBrush x:Key="Canvas" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F1EEE6" Offset="0"/>
        <GradientStop Color="#F8F6F0" Offset="0.53"/>
        <GradientStop Color="#E3EEE8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Paper" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="BrandPaper" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrandInk" Color="#263533"/>
    <SolidColorBrush x:Key="Glass" Color="#CFFFFFFF"/>
    <SolidColorBrush x:Key="GlassLine" Color="#C5C4CEC8"/>
    <SolidColorBrush x:Key="TextInk" Color="#263533"/>
    <SolidColorBrush x:Key="TextMuted" Color="#55645F"/>
    <SolidColorBrush x:Key="Line" Color="#DDD8CE"/>
    <SolidColorBrush x:Key="ControlLine" Color="#928D83"/>
    <SolidColorBrush x:Key="FieldLine" Color="#969084"/>
    <SolidColorBrush x:Key="ControlHover" Color="#F0EDE4"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#E6E1D6"/>
    <SolidColorBrush x:Key="Accent" Color="#216560"/>
    <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#195550"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#144742"/>
    <SolidColorBrush x:Key="AccentWash" Color="#E6F1ED"/>
    <SolidColorBrush x:Key="FocusRing" Color="#285B55"/>
    <SolidColorBrush x:Key="StatusNeutral" Color="#EEEAE1"/>
    <SolidColorBrush x:Key="StatusSuccess" Color="#E4F0E8"/>
    <SolidColorBrush x:Key="StatusError" Color="#FAEEE8"/>
    <SolidColorBrush x:Key="ErrorInk" Color="#85372F"/>
    <SolidColorBrush x:Key="Clear" Color="Transparent"/>

    <Style x:Key="WorkspaceFocus" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border BorderBrush="{DynamicResource FocusRing}" BorderThickness="2"
                            CornerRadius="6" Margin="-2" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="0,0,8,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlPressed}"/>
            </Trigger>
            <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentWash}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInk}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPressed}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CancelAction" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EditorField" TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource EditorField}">
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="SelectionTextBrush" Value="{DynamicResource AccentInk}"/>
        <Setter Property="SelectionOpacity" Value="1"/>
    </Style>
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource EditorField}"/>
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FieldLine}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ClipToBounds="True"/>
                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" StrokeThickness="1.5"
                                      Stroke="{DynamicResource TextInk}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{DynamicResource Clear}"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" Focusable="False" AllowsTransparency="True"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource FieldLine}"
                                    BorderThickness="1" CornerRadius="5" Padding="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ComboSurface" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="ItemSurface" Background="{DynamicResource Clear}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentWash}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <DockPanel x:Name="CheckSurface" Background="{DynamicResource Clear}">
                        <Border x:Name="MarkSurface" Width="17" Height="17" Margin="0,0,6,0"
                                VerticalAlignment="Center" CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource FieldLine}" Background="{DynamicResource Paper}">
                            <Path x:Name="CheckMark" Data="M 0,4 L 3,7 L 9,0"
                                  Stroke="{DynamicResource AccentInk}" StrokeThickness="1.8"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MarkSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MarkSurface" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="MarkSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource Paper}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource WorkspaceFontSize}"/>
        <Setter Property="Padding" Value="4"/>
        <!-- The default template paints a light icon gutter on the left, which shows as a white strip in dark mode. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border x:Name="MenuPaper" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextInk}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="MenuSurface" Background="{DynamicResource Clear}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource ControlPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MenuSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel IsItemsHost="True" Margin="0,0,0,9"/>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontFamily" Value="{DynamicResource WorkspaceFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="{DynamicResource WorkspaceTabPadding}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="{DynamicResource Clear}"
                            Background="{DynamicResource Clear}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="TabLabel" ContentSource="Header" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="TabLabel" Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentWash}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorDividerStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Border x:Name="DividerHitArea" Background="{DynamicResource Clear}" CornerRadius="4">
                        <Border x:Name="DividerLine" Width="2" Margin="0,3" HorizontalAlignment="Center"
                                CornerRadius="1" Background="{DynamicResource ControlLine}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DividerHitArea" Property="Background" Value="{DynamicResource AccentWash}"/>
                            <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="DividerLine" Property="Background" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="SliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Border Background="{DynamicResource Clear}"/>
    </ControlTemplate>
    <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid x:Name="SliderSurface" Background="{DynamicResource Clear}">
                        <Border Margin="8,0" Height="3" VerticalAlignment="Center"
                                CornerRadius="1.5" Background="{DynamicResource ControlLine}"/>
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Template="{StaticResource SliderTrackButton}" Focusable="False"
                                              Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Ellipse Fill="{DynamicResource Accent}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Template="{StaticResource SliderTrackButton}" Focusable="False"
                                              Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SliderSurface" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="Canvas" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#111B20" Offset="0"/>
        <GradientStop Color="#18232A" Offset="0.53"/>
        <GradientStop Color="#223834" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Paper" Color="#202B31"/>
    <SolidColorBrush x:Key="Glass" Color="#CC27363D"/>
    <SolidColorBrush x:Key="GlassLine" Color="#807F9693"/>
    <SolidColorBrush x:Key="TextInk" Color="#EDF3F1"/>
    <SolidColorBrush x:Key="TextMuted" Color="#BCCBC7"/>
    <SolidColorBrush x:Key="Line" Color="#4B605F"/>
    <SolidColorBrush x:Key="ControlLine" Color="#758B88"/>
    <SolidColorBrush x:Key="FieldLine" Color="#758B88"/>
    <SolidColorBrush x:Key="ControlHover" Color="#33454B"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#3B5154"/>
    <SolidColorBrush x:Key="Accent" Color="#8DD6C6"/>
    <SolidColorBrush x:Key="AccentInk" Color="#102926"/>
    <SolidColorBrush x:Key="AccentHover" Color="#A7E6D8"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#74BEAF"/>
    <SolidColorBrush x:Key="AccentWash" Color="#304D4B"/>
    <SolidColorBrush x:Key="FocusRing" Color="#9AE2D1"/>
    <SolidColorBrush x:Key="StatusNeutral" Color="#2A3940"/>
    <SolidColorBrush x:Key="StatusSuccess" Color="#263E37"/>
    <SolidColorBrush x:Key="StatusError" Color="#462D2B"/>
    <SolidColorBrush x:Key="ErrorInk" Color="#F8C4B6"/>
</ResourceDictionary>
